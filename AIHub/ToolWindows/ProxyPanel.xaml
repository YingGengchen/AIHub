<UserControl x:Class="AIHub.ToolWindows.ProxyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AhPanel}"
             Foreground="{DynamicResource AhText}"
             FontFamily="Segoe UI"
             FontSize="13"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <!-- 颜色键由 ThemePalette 在运行时填充，跟随 Visual Studio 主题。 -->
        <SolidColorBrush x:Key="AhPanel" Color="#FF252526" />
        <SolidColorBrush x:Key="AhSurface" Color="#FF2D2D30" />
        <SolidColorBrush x:Key="AhSurfaceHover" Color="#FF3A3A3D" />
        <SolidColorBrush x:Key="AhBorder" Color="#FF3F3F46" />
        <SolidColorBrush x:Key="AhText" Color="#FFF1F1F1" />
        <SolidColorBrush x:Key="AhMuted" Color="#FF9D9D9D" />
        <SolidColorBrush x:Key="AhInput" Color="#FF333337" />
        <SolidColorBrush x:Key="AhAccent" Color="#FF0E639C" />
        <SolidColorBrush x:Key="AhOnAccent" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="AhSelection" Color="#FF264F78" />
        <SolidColorBrush x:Key="AhSuccess" Color="#FF4EC97A" />
        <SolidColorBrush x:Key="AhDanger" Color="#FFF85149" />
        <SolidColorBrush x:Key="AhScrim" Color="#B8000000" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AhSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AhBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,12,14,14" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AhText}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AhMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AhMuted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource AhText}" />
            <Setter Property="Background" Value="{DynamicResource AhInput}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AhText}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AhAccent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource AhBorder}"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AhSurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AhAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputPassword" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource AhText}" />
            <Setter Property="Background" Value="{DynamicResource AhInput}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AhText}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource AhBorder}"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AhSurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AhAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource AhText}" />
            <Setter Property="Background" Value="{DynamicResource AhInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AhBorder}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource AhText}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="9,5" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Row"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource AhSurfaceHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource AhAccent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Frame"
                                                Background="{DynamicResource AhInput}"
                                                BorderBrush="{DynamicResource AhBorder}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                SnapsToDevicePixels="True">
                                            <Path Data="M 0 0 L 4 4 L 8 0"
                                                  Stroke="{DynamicResource AhMuted}"
                                                  StrokeThickness="1.4"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,9,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AhSurfaceHover}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AhAccent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource AhInput}"
                                        BorderBrush="{DynamicResource AhBorder}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AhText}" />
            <Setter Property="Background" Value="{DynamicResource AhSurfaceHover}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource AhBorder}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Foreground" Value="{DynamicResource AhOnAccent}" />
            <Setter Property="Background" Value="{DynamicResource AhAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProviderItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource AhText}" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AhSurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AhSelection}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：标题 + 状态 + 端口 + 启停 + 操作 -->
        <Border Grid.Row="0"
                Background="{DynamicResource AhSurface}"
                BorderBrush="{DynamicResource AhBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="AI Hub 代理" FontSize="15" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Border x:Name="StatusPill"
                                    Background="{DynamicResource AhSelection}"
                                    CornerRadius="9"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource AhDanger}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StatusText" Text="已停止" Margin="6,0,0,0" FontSize="11.5" Foreground="{DynamicResource AhText}" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="EndpointText"
                                       Text="http://localhost:11434"
                                       Margin="10,0,0,0"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource AhMuted}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="端口" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" />
                        <TextBox x:Name="PortBox" Style="{StaticResource InputBox}" Width="72" Text="11434"
                                 HorizontalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button x:Name="StartStopButton" Style="{StaticResource PrimaryButton}"
                                Content="启动代理" MinWidth="92" Padding="14,7" />
                        <Button x:Name="RestartButton" Content="重启代理"
                                Style="{StaticResource BaseButton}" MinWidth="92" Padding="14,7" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="SaveButton" Grid.Column="0" Content="保存并应用"
                            Style="{StaticResource PrimaryButton}" MinWidth="96" />
                    <Button x:Name="CopyAddressButton" Grid.Column="2" Content="复制代理地址"
                            Style="{StaticResource BaseButton}" MinWidth="80" Margin="0,0,8,0" />
                    <Button x:Name="OpenConfigButton" Grid.Column="3" Content="打开配置目录"
                            Style="{StaticResource BaseButton}" MinWidth="80" />
                </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,14,16,14">
            <StackPanel>

                <!-- 连接设置 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="连接设置" Style="{StaticResource CardTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="提供方" Style="{StaticResource FieldLabel}"
                                               Margin="0" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="AddProviderButton" Content="新增"
                                                Style="{StaticResource BaseButton}"
                                                MinWidth="0" Padding="7,1" FontSize="11" Margin="0,0,4,0" />
                                        <Button x:Name="RemoveProviderButton" Content="删除"
                                                Style="{StaticResource BaseButton}"
                                                MinWidth="0" Padding="7,1" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                                <Border Background="{DynamicResource AhInput}"
                                        BorderBrush="{DynamicResource AhBorder}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="3">
                                    <ListBox x:Name="ProviderList"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Height="132"
                                             ItemContainerStyle="{StaticResource ProviderItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Display}"
                                                           ToolTip="{Binding ToolTip}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                                <TextBlock Style="{StaticResource Hint}" Margin="2,4,0,0" FontSize="10.5"
                                           Text="✱ 为自定义提供方" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Base URL" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="BaseUrlBox" Style="{StaticResource InputBox}" />

                                <TextBlock Text="API Key" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="ApiKeyBox" Grid.Column="0" Style="{StaticResource InputPassword}" />
                                    <TextBox x:Name="ApiKeyPlainBox" Grid.Column="0" Style="{StaticResource InputBox}"
                                             FontFamily="Consolas" Visibility="Collapsed" />
                                    <CheckBox x:Name="ShowKeyCheck" Grid.Column="1" Content="显示"
                                              Foreground="{DynamicResource AhMuted}" FontSize="12"
                                              Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="接口协议" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ProtocolBox" Style="{StaticResource InputCombo}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="重试次数" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="RetriesBox" Style="{StaticResource InputBox}"
                                                 Width="72" Text="0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="备用模型（可选，主模型重试耗尽后自动切换）"
                                           Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                <TextBox x:Name="FallbackBox" Style="{StaticResource InputBox}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 模型 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="模型" Style="{StaticResource CardTitle}"
                                       Margin="0" VerticalAlignment="Center" />
                            <Button x:Name="FetchModelsButton" Grid.Column="1" Content="拉取可用模型"
                                    Style="{StaticResource BaseButton}" MinWidth="100" />
                        </Grid>

                        <TextBlock Text="模型列表（每行一个，格式：提供方/模型）" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ModelsBox" Style="{StaticResource InputBox}"
                                 Height="88"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 VerticalContentAlignment="Top" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="示例：deepseek/deepseek-v4-flash。这些名称会出现在 Copilot Chat 的模型选择器里。点“拉取可用模型”可用当前提供方的 API Key 自动获取模型名。" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="上下文长度（token）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ContextBox" Style="{StaticResource InputBox}" Width="140" Text="1048576" />
                            </StackPanel>

                            <CheckBox x:Name="AutoStartCheck" Grid.Column="1"
                                      Content="Visual Studio 启动时自动启动代理"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,6"
                                      Foreground="{DynamicResource AhText}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 日志 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="日志" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="ClearLogButton" Content="清空" Style="{StaticResource BaseButton}" MinWidth="60" Margin="0,0,8,0" />
                                <Button x:Name="OpenTodayLogButton" Content="今日日志" Style="{StaticResource BaseButton}" MinWidth="72" Margin="0,0,8,0" />
                                <Button x:Name="DeleteLogsButton" Content="删除日志" Style="{StaticResource BaseButton}" MinWidth="72" Margin="0,0,8,0" />
                                <Button x:Name="OpenLogDirButton" Content="打开日志目录" Style="{StaticResource BaseButton}" MinWidth="72" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox x:Name="LogEnabledCheck" Grid.Column="0"
                                      Content="记录日志"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource AhText}" />

                            <TextBox x:Name="LogDirBox" Grid.Column="1"
                                     Style="{StaticResource InputBox}"
                                     Margin="14,0,8,0"
                                     VerticalContentAlignment="Center" />

                            <Button x:Name="BrowseLogDirButton" Grid.Column="2" Content="设置保存位置…"
                                    Style="{StaticResource BaseButton}" MinWidth="60" Margin="0,0,6,0" />
                            <Button x:Name="ResetLogDirButton" Grid.Column="3" Content="恢复默认"
                                    Style="{StaticResource BaseButton}" MinWidth="52" />
                        </Grid>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="取消记录日志后此面板将不会显示任何内容" />                        <TextBox x:Name="LogBox" Style="{StaticResource InputBox}"
                                 IsReadOnly="True"
                                 Height="170"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="11.5"
                                 VerticalContentAlignment="Top" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Hint}" Margin="2,0,2,6">
                    使用方法：Copilot Chat → 模型选择器 → 管理模型 → 添加 Ollama → 地址填上面的
                    http://localhost:端口 → 勾选模型后保存。
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- 拉取模型：覆盖式选择层 -->
        <Border x:Name="PickerOverlay" Grid.Row="0" Grid.RowSpan="2"
                Background="{StaticResource AhScrim}"
                Visibility="Collapsed">
            <Border Style="{StaticResource Card}"
                    MaxWidth="580"
                    MaxHeight="560"
                    Margin="22"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="拉取可用模型" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="PickerProviderText" Grid.Row="1" Style="{StaticResource Hint}" Margin="0,-6,0,10" />

                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PickerFilterBox" Grid.Column="0" Style="{StaticResource InputBox}"
                                 ToolTip="按名称筛选" />
                        <CheckBox x:Name="PickerHideNonChatCheck" Grid.Column="1" Content="隐藏非对话模型"
                                  Foreground="{DynamicResource AhMuted}" FontSize="12"
                                  Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="True" />
                    </Grid>

                    <Border Grid.Row="3" Background="{DynamicResource AhInput}"
                            BorderBrush="{DynamicResource AhBorder}"
                            BorderThickness="1" CornerRadius="4" Padding="4" MinHeight="140">
                        <Grid>
                            <ListBox x:Name="PickerList" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource ProviderItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  ToolTip="{Binding Name}"
                                                  Foreground="{DynamicResource AhText}"
                                                  FontFamily="Consolas"
                                                  FontSize="12"
                                                  Checked="OnPickerChoiceToggled"
                                                  Unchecked="OnPickerChoiceToggled" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="PickerEmptyText" Text="没有匹配的模型"
                                       Foreground="{DynamicResource AhMuted}" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PickerAllButton" Grid.Column="0" Content="全选"
                                Style="{StaticResource BaseButton}" MinWidth="58" Margin="0,0,6,0" />
                        <Button x:Name="PickerNoneButton" Grid.Column="1" Content="全不选"
                                Style="{StaticResource BaseButton}" MinWidth="64" Margin="0,0,6,0" />
                        <Button x:Name="PickerInvertButton" Grid.Column="2" Content="反选"
                                Style="{StaticResource BaseButton}" MinWidth="58" />
                        <TextBlock x:Name="PickerCountText" Grid.Column="3" Text="已选 0 个"
                                   Style="{StaticResource Hint}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="8,0,12,0" />
                        <Button x:Name="PickerCancelButton" Grid.Column="4" Content="取消"
                                Style="{StaticResource BaseButton}" MinWidth="72" Margin="0,0,8,0" />
                        <Button x:Name="PickerAddButton" Grid.Column="5" Content="添加所选"
                                Style="{StaticResource PrimaryButton}" MinWidth="92" />
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- 新增自定义提供方 -->
        <Border x:Name="AddProviderOverlay" Grid.Row="0" Grid.RowSpan="2"
                Background="{StaticResource AhScrim}"
                Visibility="Collapsed">
            <Border Style="{StaticResource Card}"
                    MaxWidth="480"
                    Margin="22"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="新增自定义提供方" Style="{StaticResource CardTitle}" />

                    <TextBlock Text="名称（作为模型前缀）" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NewProviderNameBox" Style="{StaticResource InputBox}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="例如 openrouter、lmstudio、oneapi。模型写成 名称/模型ID，如 openrouter/anthropic/claude-sonnet-4。" />

                    <TextBlock Text="Base URL" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                    <TextBox x:Name="NewProviderUrlBox" Style="{StaticResource InputBox}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="OpenAI 兼容地址，例如 https://openrouter.ai/api/v1 或 http://localhost:1234/v1" />

                    <TextBlock Text="接口协议" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                    <ComboBox x:Name="NewProviderProtocolBox" Style="{StaticResource InputCombo}" />

                    <TextBlock Text="API Key（本地服务可留空）" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                    <PasswordBox x:Name="NewProviderKeyBox" Style="{StaticResource InputPassword}" />

                    <TextBlock x:Name="NewProviderErrorText" Style="{StaticResource Hint}"
                               Foreground="{DynamicResource AhDanger}"
                               Margin="0,10,0,0" Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button x:Name="NewProviderCancelButton" Content="取消"
                                Style="{StaticResource BaseButton}" MinWidth="72" Margin="0,0,8,0" />
                        <Button x:Name="NewProviderOkButton" Content="添加"
                                Style="{StaticResource PrimaryButton}" MinWidth="80" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
